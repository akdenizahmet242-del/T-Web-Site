# -----------------------------------------------------------------------------
#  Kopyalayın:  cp .env.example .env      (Windows PowerShell: Copy-Item .env.example .env)
# -----------------------------------------------------------------------------

# --- Veritabanı ---------------------------------------------------------------
# docker-compose.yml ile gelen PostgreSQL (host portu 5433)
DATABASE_URL="postgresql://tws:tws_dev_password@localhost:5433/tws?schema=public"
# Uygulama sürecinin açacağı en fazla bağlantı (serverless'ta düşük tutun, PgBouncer önerilir)
DATABASE_POOL_MAX="10"

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Kimlik doğrulama (Auth.js v5) -------------------------------------------
# Üretmek için:  npx auth secret   veya   openssl rand -base64 33
AUTH_SECRET="degistir-beni-en-az-32-karakterlik-rastgele-bir-deger"
# Reverse proxy / Docker arkasında host doğrulaması için
AUTH_TRUST_HOST="true"

# --- Seed ile oluşturulacak yönetici -----------------------------------------
SEED_ADMIN_EMAIL="admin@tws.local"
SEED_ADMIN_PASSWORD="Admin123!"
# Analitik ekranı için 60 güne yayılmış demo siparişler (false → oluşturma)
SEED_DEMO_ORDERS="true"

# --- Önbellek / ISR -----------------------------------------------------------
# Panel dışı sistemlerin (ERP, PIM) /api/revalidate webhook'unu çağırması için
REVALIDATE_SECRET="degistir-beni-revalidate"

# Ödeme süresi dolan siparişlerin stoğunu bırakan cron ucu (/api/cron/release-orders)
CRON_SECRET="degistir-beni-cron"

# --- Dosya deposu -------------------------------------------------------------
# local → ./storage dizini, /media/* üzerinden servis edilir (S3/R2 sürücüsü Faz 3)
STORAGE_DRIVER="local"

# --- Görsel CDN ---------------------------------------------------------------
# next/image'in optimize edeceği uzak hostlar (virgülle ayrılmış)
IMAGE_REMOTE_HOSTS="images.unsplash.com,res.cloudinary.com"

# --- Ödeme --------------------------------------------------------------------
# mock | iyzico | paytr | stripe   (ilk aşamada yalnızca mock aktif)
PAYMENT_PROVIDER="mock"
# Mock POS callback imzası (boşsa AUTH_SECRET kullanılır)
MOCK_POS_SECRET=""

# --- Reklam & İzleme ----------------------------------------------------------
# Boş bırakılırsa script yüklenmez; olaylar geliştirmede konsola yazılır.
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
